{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../sdk_data/*",
      "resources/*"
    ],
    "icon": [
      "Images/icon.ico"
    ]
  },
  "productName": "MoLaunch",
  "mainBinaryName": "MoLaunch",
  "version": "0.1.0",
  "identifier": "com.moteam.molaunch",
  "plugins": {},
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "decorations": false,
        "resizable": true,
        "title": "MoLaunch",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}