{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "MoTeam",
    "copyright": "Copyright © 2026 MoTeam. All rights reserved.",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/*": "."
    },
    "icon": [
      "Images/icon.ico",
      "Images/icon.png",
      "Images/icon.icns"
    ]
  },
  "productName": "MoLaunch",
  "mainBinaryName": "MoLaunch",
  "version": "0.3.6-rc3",
  "identifier": "com.moteam.molaunch",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.molaunch.moiu.cn/v3/updates/manifest?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyNTgyQTQ3NDU5RjIwMTcKUldRWElKOUZSeXBZRXZJT2pkWUZtQkUvODdlYTdVZjgvRWFFN0FqYXhYTmhhVTdYU1lVLzY5NkUK",
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["molaunch"]
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splashscreen",
        "url": "splash.html",
        "title": "MoLaunch",
        "width": 640,
        "height": 200,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "center": true,
        "alwaysOnTop": true,
        "visible": true,
        "backgroundColor": "#eef3ff"
      },
      {
        "label": "main",
        "fullscreen": false,
        "decorations": false,
        "resizable": false,
        "title": "MoLaunch",
        "width": 1096,
        "height": 592,
        "center": true,
        "useHttpsScheme": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: cache-image: https://cache-image.localhost res: https://res.localhost https://*.minecraft.net https://*.mojang.com https://crafatar.com https://bmclapi2.bangbang93.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost https://cache-image.localhost res: https://res.localhost ws://127.0.0.1:* http://127.0.0.1:* https://*.minecraft.net https://*.mojang.com https://login.live.com https://login.microsoftonline.com https://*.xboxlive.com https://bmclapi2.bangbang93.com https://maven.minecraftforge.net https://maven.neoforged.net https://maven.fabricmc.net https://api.molaunch.moiu.cn https://download.mocdn.net; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  }
}