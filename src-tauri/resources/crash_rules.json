    {
      "id": "java-unsupported-class-version",
      "cause": "java_version",
      "category": "java_version",
      "severity": "error",
      "confidence": "high",
      "title": "Java 版本过低",
      "impact": "游戏在类加载阶段就中断，表现为启动瞬间退出或卡在加载界面。",
      "suggestion": "日志里写明了 class 编译版本与运行时版本，装一个不低于该版本的 Java（如 Java 21）并在启动器里切换过去。",
      "match": {
        "any": [
          "unsupportedclassversionerror",
          "unsupported class file major version",
          "has been compiled by a more recent version"
        ]
      },
      "evidence": {
        "any": [
          "unsupportedclassversionerror",
          "unsupported class file major version"
        ]
      },
      "actions": [
        {
          "type": "open_settings_java"
        }
      ]
    },
